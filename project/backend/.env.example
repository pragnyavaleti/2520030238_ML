# Server Port
PORT=5000

# Python FastAPI Machine Learning Service URL
ML_SERVICE_URL=http://127.0.0.1:8000

# Firebase Firestore Configuration
# Provide Firebase Service Account Path or environment credentials:
FIREBASE_PROJECT_ID=crop-yield-prediction-ml
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@crop-yield-prediction-ml.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...-----END PRIVATE KEY-----\n"
# Or path to serviceAccountKey.json:
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# If Firebase credentials are not provided, the server automatically uses the local persistence fallback
